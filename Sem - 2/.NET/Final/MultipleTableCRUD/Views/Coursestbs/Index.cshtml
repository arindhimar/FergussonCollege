@model IEnumerable<MultipleTableCRUD.Models.Coursestb>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
<p>
    <a asp-controller="Coursestbs" asp-action="Create">Add New Course</a>
    <a asp-controller="Studenttbs" asp-action="Index">Manage Student</a>
    <a asp-controller="Enrollementtbs" asp-action="Index">Manage Enrollment</a>
</p>

</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Cname)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Cdesc)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Cname)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Cdesc)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Cid">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Cid">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Cid">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
