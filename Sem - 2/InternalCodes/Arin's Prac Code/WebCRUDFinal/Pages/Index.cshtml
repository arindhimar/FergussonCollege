@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<form method="post">

    <input type="text" asp-for="stundent.Id" />
    <input type="text" asp-for="stundent.Name" />

    <button type="submit" formaction="?handler=Add">Add</button>
    <button type="submit" formaction="?handler=Edit">Update</button>

</form>

@foreach (var s in IndexModel.Stundents)
{
    <div>
        <p>@s.Id</p>
        <p>@s.Name</p>
        <form method="post">
            <input type="hidden" name="id" value="@s.Id"/>
            <button type="submit" formaction="?handler=Delete">Delete</button>

        </form>
    </div>
    <hr/>
}